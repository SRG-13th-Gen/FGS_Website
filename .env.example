# Local MySQL/MariaDB; production uses separate databases and credentials.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=fgs_content
DB_USER=fgs_content
DB_PASSWORD=GENERATE_LOCAL_PASSWORD
MARIADB_ROOT_PASSWORD=GENERATE_LOCAL_ROOT_PASSWORD
# Absolute path outside public_html/nodejs/.next in production.
MEDIA_STORAGE_PATH=.data/media
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=GENERATE_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000
ADMIN_ALLOWED_EMAILS=
SITE_INDEXABLE=false

# Run pnpm setup:env to create an ignored .env.local with random local passwords.
# Development-only values. Never use these credentials in production.
WORDPRESS_URL=http://localhost:8080
WORDPRESS_PORT=8080
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=GENERATE_LOCAL_PASSWORD
MARIADB_ROOT_PASSWORD=GENERATE_LOCAL_ROOT_PASSWORD

# Fill these only after creating a dedicated local WordPress integration account.
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Shared with the WordPress must-use plugin through its server-side wp-config.php.
REVALIDATION_SECRET=GENERATE_REVALIDATION_SECRET

# Google OAuth web client; keep real values in ignored local or Hostinger settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=GENERATE_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000
# Comma-separated, exact approved Google email addresses. Empty denies access.
ADMIN_ALLOWED_EMAILS=

# Set true only on the reviewed live root website.
SITE_INDEXABLE=false

{
  "name": "flordegrace-school-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && pnpm build",
    "setup:env": "node scripts/setup-env.mjs",
    "docker:config": "node scripts/docker.mjs config --quiet",
    "docker:up": "node scripts/docker.mjs up -d --wait --wait-timeout 180",
    "docker:stop": "node scripts/docker.mjs stop",
    "docker:down": "node scripts/docker.mjs down",
    "docker:status": "node scripts/docker.mjs ps",
    "docker:logs": "node scripts/docker.mjs logs --tail 100",
    "wp:seed-content": "tsx scripts/seed-content.ts",
    "ui:add": "shadcn add",
    "ui:all": "shadcn add --all"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "react-resizable-panels": "4.12.4",
    "recharts": "3.8.0",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "27.4.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=10.30.2 <11"
  },
  "type": "module"
}
